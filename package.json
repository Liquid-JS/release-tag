{
    "name": "release-tag",
    "version": "4.2.5",
    "description": "Create a release on tag push.",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "changelogen": "^0.6.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@liquid-js/rollup-plugin-closure-compiler": "^0.28.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "<25.0.0",
        "commit-and-tag-version": "^13.2.1",
        "eslint": "^10.11.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^65.0.1",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "google-closure-compiler": "^20260929.0.0",
        "husky": "^9.1.7",
        "npm-check-updates": "^23.1.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.63.6",
        "tslib": "^2.8.1",
        "typescript": "<7.0.0",
        "typescript-eslint": "^8.71.0"
    },
    "scripts": {
        "build": "rimraf lib && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
        "lint": "eslint . --fix",
        "prepublishOnly": "npm run build",
        "prepare": "husky",
        "release": "yarn build && git diff --exit-code && commit-and-tag-version && git push --follow-tags origin",
        "prepack": "clean-package",
        "postpack": "clean-package restore"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/fragql.git"
    },
    "author": "HitkoDev <development@hitko.si>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Liquid-JS/fragql/issues"
    },
    "packageManager": "yarn@4.18.1",
    "clean-package": {
        "remove": [
            "packageManager",
            "scripts",
            "devDependencies",
            "clean-package"
        ]
    }
}
